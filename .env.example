# AI 配置（也可以在网页设置页中配置，二选一）
# 在 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=

# 可选：模型与接口地址
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com

# 可选：OCR 语言数据镜像（国内网络可改用 npmmirror 镜像）
# TESSDATA_MIRROR=https://registry.npmmirror.com/-/binary/tessdata/4.0.0

# 数据库文件路径（相对项目根目录）
DATABASE_URL=file:./dev.db
